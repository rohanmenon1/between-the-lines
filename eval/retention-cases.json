      "requirements": [
        {
          "id": "descending_scores",
          "description": "Higher scores appear first."
        },
        {
          "id": "stable_ties",
          "description": "Equal-score records retain arrival order."
        },
        {
          "id": "caller_input_unchanged",
          "description": "The caller's list and records remain unchanged."
        }
      ],
